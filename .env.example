# Clé OpenAI — reste côté serveur, n'est jamais transmise au frontend.
OPENAI_API_KEY=

# Modèles. Modifiables sans toucher au code.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536

# Facultatif : passerelle compatible OpenAI (laisser vide pour l'API officielle).
OPENAI_BASE_URL=

# Réglages de génération.
PROFILE_BATCH_SIZE=10
IMAGE_CONCURRENCY=3
MAX_RETRIES=4
REQUEST_TIMEOUT=180

# Sécurité et réseau.
MAX_UPLOAD_BYTES=15728640
CORS_ORIGINS=http://localhost:3000
