# Clé OpenAI — reste côté serveur, n'est jamais transmise au frontend.
OPENAI_API_KEY=

# Modèles. Modifiables sans toucher au code.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Format des visuels. 1200x1600 = 3:4 vertical, le format réclamé par le
# « Lisez-moi » du modèle. gpt-image-2 accepte toute taille dont la largeur et
# la hauteur sont divisibles par 16, en ratio compris entre 1:3 et 3:1.
OPENAI_IMAGE_SIZE=1200x1600

# Rendu des avatars :
#   illustration = portraits dessinés, identifiables comme synthétiques (défaut)
#   photo        = portraits photoréalistes. À n'utiliser que si la plateforme
#                  indique à ses utilisateurs que les personnages sont générés.
OPENAI_IMAGE_STYLE=illustration

# Facultatif : passerelle compatible OpenAI (laisser vide pour l'API officielle).
OPENAI_BASE_URL=

# Réglages de génération.
PROFILE_BATCH_SIZE=10
IMAGE_CONCURRENCY=3
MAX_RETRIES=4
REQUEST_TIMEOUT=180

# Sécurité et réseau.
MAX_UPLOAD_BYTES=15728640
CORS_ORIGINS=http://localhost:3000
